{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "NexCloud",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#000000"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.nexcloud.in",
          "icon": "book-open-cover",
          "color": {
            "light": "#000000",
            "dark": "#000000"
          }
        },
        {
          "anchor": "Website",
          "icon": "airplay",
          "color": {
            "light": "#ffffff",
            "dark": "#ffffff"
          },
          "href": "https://nexcloud.in"
        }
      ]
    },
    "groups": []
  },
  "logo": {
    "light": "/images/Profile_Banner-removebg-preview.png",
    "dark": "/logo/wordmark.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:support@nexcloud.in",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Home",
      "href": "https://nexcloud.in"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  }
}
