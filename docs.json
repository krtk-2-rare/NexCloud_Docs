{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "NexCloud",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#000000"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.nexcloud.in",
          "icon": "book-open-cover"
        }
      ]
    },
    "anchors": [
      {
        "anchor": "Client Area",
        "icon": "browser",
        "href": "https://cpdash.nexcloud.in"
      },
      {
        "anchor": "VPS Panel",
        "icon": "square-terminal",
        "href": "https://vpanel.nexcloud.in"
      },
      {
        "anchor": "Untitled Anchor",
        "groups": [
          {
            "group": "Untitled Group",
            "pages": []
          }
        ]
      },
      {
        "anchor": "Network Status",
        "icon": "chart-simple",
        "href": "https://nexcloud.instatus.com"
      }
    ]
  },
  "logo": {
    "light": "/logo/wordmark.svg",
    "dark": "/logo/wordmark.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:support@nexcloud.in",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Home",
      "href": "https://nexcloud.in"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  }
}
