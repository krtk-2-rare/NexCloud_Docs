{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "NexCloud",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#000000"
  },
  "favicon": {
    "light": "/images/1.png",
    "dark": "/images/1.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.nexcloud.in",
          "icon": "book-open-cover",
          "color": {
            "light": "#000000",
            "dark": "#000000"
          }
        },
        {
          "anchor": "Website",
          "icon": "airplay",
          "color": {
            "light": "#ffffff",
            "dark": "#ffffff"
          },
          "href": "https://nexcloud.in"
        }
      ]
    },
    "groups": []
  },
  "logo": {
    "light": "/images/Profile_Banner-removebg-preview.png",
    "dark": "/logo/wordmark.svg",
    "href": "https://nexcloud.in"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:assist@nexcloud.in",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Home",
      "href": "https://nexcloud.in"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/next-2-beat",
      "discord": "https://discord.gg/Gp9TpKXZ6T",
      "instagram": "https://www.instagram.com/nexcloudhostings"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "decoration": "grid"
  }
}
